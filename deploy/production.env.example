# Copy these values into the tester machine environment, or use
# scripts\run-production-client.ps1 with -AuthorityUrl and -MultiplayerUrl.
SOLAMON_REQUIRE_AUTHORITY=1
SOLAMON_AUTHORITY_URL=https://solamon-authority.vercel.app/api
SOLAMON_MULTIPLAYER_URL=wss://solamon-presence.onrender.com
SOLAMON_RPC_URL=https://api.devnet.solana.com
